DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_MIGRATION_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_POOL_MAX=5
BUSINESS_TIME_ZONE=America/New_York

# Solace Cloud: se completan en las fases de integración y worker.
SOLACE_URL=wss://your-solace-endpoint
SOLACE_VPN=your-message-vpn
SOLACE_USERNAME=your-messaging-username
SOLACE_PASSWORD=your-messaging-password
SOLACE_QUEUE_AVAILABLE=newcron.global-dispatch.available.v1
SOLACE_QUEUE_RESULTS=newcron.global-dispatch.results.v1
SOLACE_TOPIC_PREFIX=newcron/dispatch/v1
